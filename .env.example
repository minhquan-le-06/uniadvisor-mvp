# Copy to .env (git-ignored) and fill in. Shell variables override this file.
# Gemini keys for `uniadvisor gold-llm` and `uniadvisor slm-relabel`: comma-separated...
GEMINI_API_KEYS=key1,key2,key3
# ...or numbered, one per line (both forms can be mixed):
# GEMINI_API_KEY_1=key1
# GEMINI_API_KEY_2=key2
